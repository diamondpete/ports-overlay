# PhoenixAdult configuration. Copy to /var/db/phoenixadult/.env and edit.
# Every supported variable is listed with its default; uncomment a line to
# override. Relative paths (./local/...) resolve under the working dir
# (/var/db/phoenixadult). Sections mirror the /config UI tabs; see
# docs/configuration.md for full descriptions.

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
#PHOENIX_BASE_URL=
#ADMIN_TOKEN=
#ENV_OVERRIDES_PATH=

# ── Matching & Title Parsing ─────────────────────────────────────────────────
#STRIP_ENABLE=false
#STRIP_SYMBOL=
#STRIP_SYMBOL_REVERSE=
#SEARCH_TITLE_TRASH=
#SEARCH_STRIP_ACTORS=
#DISABLE_AUTO_MATCH=false

# ── Scraping & Pacing ────────────────────────────────────────────────────────
#PHOENIX_EXTRA_COLLECTIONS=false
#SCENE_GAP=10
#REFRESH_FORCE_COUNT=3
#SEARCH_STORE_TTL_DAYS=0

# ── HTTP Bypass ──────────────────────────────────────────────────────────────
#FLARESOLVERR_URL=
#REQBIN_ENABLE=false
#REQBIN_API_KEY=
#BYPASS_ORDER=Impersonate,FlareSolverr,Playwright,ReqBin
#PLAYWRIGHT_BROWSER=chromium
#BYPASS_AUTO_RETRY=false
#BYPASS_TIMEOUT_MS=10000
#PLAYWRIGHT_BROWSERS_PATH=/var/db/phoenixadult/ms-playwright
#TMPDIR=/var/db/phoenixadult/tmp

# ── Web Search ───────────────────────────────────────────────────────────────
#GOOGLE_SEARCH_API_KEY=
#GOOGLE_SEARCH_CX=

# ── Data18 Enrichment ────────────────────────────────────────────────────────
#DATA18_ENABLE=false
#DATA18_ACCURACY=100
#DATA18_EXTRA=false

# ── MetadataAPI ──────────────────────────────────────────────────────────────
#METADATAAPI_TOKEN=

# ── Manual NFO ───────────────────────────────────────────────────────────────
#MANUAL_NFO_PATH=/var/db/phoenixadult/local/manual
#MANUAL_NFO_TOKEN=manual

# ── People Cache & Sources ───────────────────────────────────────────────────
#PEOPLE_CACHE_DIR=/var/db/phoenixadult/local/images/people
#PEOPLE_CACHE_ENABLE=true
#PEOPLE_CACHE_REPLACE_ENABLE=false
#PEOPLE_CACHE_FACE_ENABLE=false
#PEOPLE_SOURCE_ORDER=Local Storage,Scene,AdultDVDEmpire,Freeones,IAFD,Indexxx,Boobpedia,Babes and Stars,Babepedia
#ADULT_EMPIRE_LOGIN_TOKEN=

# ── Gender Handling ──────────────────────────────────────────────────────────
#GENDER_DETECT_ENABLE=true
#GENDER_SKIP_MALE_ENABLE=false
#GENERIC_IMAGE_ENABLE=true
#GENERIC_FEMALE_URL=
#GENERIC_MALE_URL=

# ── Images ───────────────────────────────────────────────────────────────────
#IMAGE_DIR=/var/db/phoenixadult/local/images
#IMAGE_MAX_BYTES=20M
#IMAGE_PROXY_PIN=true
#IMAGE_BASE_URL=baseurl
#LOGO_CACHE_DIR=

# ── Metadata Cache ───────────────────────────────────────────────────────────
#METADATA_CACHE_ENABLE=false
#METADATA_CACHE_DIR=/var/db/phoenixadult/local/metadata
#STATE_DB_PATH=/var/db/phoenixadult/local/phoenixadult.db
#DB_BACKUP_INTERVAL_HOURS=24
#DB_BACKUP_KEEP=7
# Best on a different local disk than STATE_DB_PATH; blank = a backups/ folder beside it.
#DB_BACKUP_DIR=

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
#LOG_DIR=/var/db/phoenixadult/logs
#LOG_REDACT_HOSTS=false
#LOG_REDACT_TOKEN=false

# ── Plex Server ──────────────────────────────────────────────────────────────
#PLEX_URL=
#PLEX_TOKEN=
#PLEX_CLIENT_ID=

# ── Network ──────────────────────────────────────────────────────────────────
#HTTP_PROXY=
#HTTPS_PROXY=
#NO_PROXY=
